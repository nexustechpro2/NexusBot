# ─── WhatsApp Session ─────────────────────────────────────────────────────────
# Get your Session ID at: https://nexusbot.qzz.io/session
# Example: NEXUSBOT-abc123XYZ
SESSION_ID=

# Your WhatsApp number with country code, digits only
# Example: 2347012345678  (for +234 701 234 5678)
WHATSAPP_PHONE_NUMBER=234xxxxxxx

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave blank to use embedded PGlite (auto-created in data/db/)
# For production, paste a PostgreSQL connection string:
# Example: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production